<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for geist. scripts/package.ps1 fills the @TOKENS@.
  Publisher MUST equal the Subject of the certificate the package is signed
  with, or Windows refuses to install it. The default is a placeholder.

  A full-trust Win32 app: geist.exe, conpty.dll and OpenConsole.exe sit in the
  package root, so the sideloaded ConPTY (kitty graphics) works as it does from
  the portable zip.

  Default-terminal handoff (src/handoff.rs): the terminal half is declared -
  our ITerminalHandoff3 COM server (geist.exe -Embedding), the proxy/stub
  (geistHandoffProxy.dll) and the com.microsoft.windows.terminal.host app
  extension that Settings > For developers > Terminal lists. The console half
  (com.microsoft.windows.console.host) is NOT declared: the NuGet
  OpenConsole.exe we ship has Windows Terminal's CLSID compiled in, so
  declaring it would collide with Windows Terminal. The class and IIDs below
  must match src/handoff.rs and vendor/terminal-handoff/dlldata.c.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com desktop rescap">

  <Identity Name="geist.geist" Publisher="@PUBLISHER@" Version="@VERSION4@" ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>geist</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A GPU-accelerated terminal for Windows on Ghostty's VT engine.</Description>
  </Properties>

  <Dependencies>
    <!-- 19041 (20H1): the floor for the sideloaded ConPTY and for App Installer auto-update. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="geist" Executable="geist.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="geist"
        Description="geist terminal"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- `geist` on PATH from any shell, like `wt`. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="geist.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="geist.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- Default terminal: what Settings lists as a terminal. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.terminal.host" Id="geist" DisplayName="geist" Description="geist terminal" PublicFolder="Public">
            <uap3:Properties>
              <Clsid>{2CED21A9-5236-4F72-B71F-10F3949295E5}</Clsid>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <!-- The proxy/stub that marshals EstablishPtyHandoff's handles. -->
        <com:Extension Category="windows.comInterface">
          <com:ComInterface>
            <com:ProxyStub Id="4CDF6A34-42C2-488C-84D2-4BC3F55F519D" DisplayName="geistHandoffProxy" Path="geistHandoffProxy.dll" />
            <!-- ITerminalHandoff3 -->
            <com:Interface Id="6F23DA90-15C5-4203-9DB0-64E73F1B1B00" ProxyStubClsid="4CDF6A34-42C2-488C-84D2-4BC3F55F519D" />
          </com:ComInterface>
        </com:Extension>
        <!-- COM launches `geist.exe -Embedding` for OpenConsole's handoff. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer DisplayName="geist" Executable="geist.exe">
              <com:Class Id="2CED21A9-5236-4F72-B71F-10F3949295E5" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
